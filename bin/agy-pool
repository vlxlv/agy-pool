# Dynamic path tracking & hooks
def _sync_paths_from_config():
    global GEMINI_DIR, POOL_CONFIG_FILE, PID_FILE, LOG_FILE, AGY_CLI_DIR, AGY_TOKEN_FILE
    GEMINI_DIR = config.GEMINI_DIR
    POOL_CONFIG_FILE = config.POOL_CONFIG_FILE
    PID_FILE = config.PID_FILE
    LOG_FILE = config.LOG_FILE
    AGY_CLI_DIR = config.AGY_CLI_DIR
    AGY_TOKEN_FILE = config.AGY_TOKEN_FILE

config.register_configure_hook(_sync_paths_from_config)
_sync_paths_from_config()

def configure_paths(gemini_dir=None):
    res = config.configure_paths(gemini_dir)
    _sync_paths_from_config()
    return res

