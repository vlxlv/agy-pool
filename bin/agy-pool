# ----------------- Quota Display & Account Management -----------------
def list_accounts(target=None):
    pool = load_pool()
    accounts = pool.get("accounts", [])
    if not accounts:
        print(f"\n{CLR_YELLOW}No accounts in pool yet.{CLR_RESET}")
        print(f"Run {CLR_BOLD}agy-pool login{CLR_RESET} or {CLR_BOLD}agy-pool import-current{CLR_RESET} to add accounts.\n")
        return

    if target:
        if str(target).isdigit():
            idx = int(target) - 1
            if 0 <= idx < len(accounts):
                accounts = [accounts[idx]]
            else:
                print(f"{CLR_RED}[Error] Account '{target}' not found.{CLR_RESET}")
                return
        else:
            found = next((a for a in accounts if a.get("id") == target or a.get("email") == target or a.get("name") == target), None)
            if found:
                accounts = [found]
            else:
                print(f"{CLR_RED}[Error] Account '{target}' not found.{CLR_RESET}")
                return

    print(f"\n{CLR_BOLD}{CLR_CYAN}Refreshing quota for {len(accounts)} account(s)...{CLR_RESET}")
    # Refresh all quotas concurrently
    threads = []
    for acc in accounts:
        t = threading.Thread(target=lambda a: _safe_quota(a), args=(acc,))
        threads.append(t)
        t.start()
    for t in threads:
        t.join(timeout=8)

    pool = load_pool()
    if target:
        # Re-fetch filtered account after quota refresh
        all_accs = pool.get("accounts", [])
        if str(target).isdigit():
            idx = int(target) - 1
            accounts = [all_accs[idx]] if 0 <= idx < len(all_accs) else []
        else:
            found = next((a for a in all_accs if a.get("id") == target or a.get("email") == target or a.get("name") == target), None)
            accounts = [found] if found else []
    else:
        accounts = pool.get("accounts", [])

    daemon_running = is_daemon_running()
    gateway_status = f"{CLR_GREEN}RUNNING (127.0.0.1:{DEFAULT_PORT}){CLR_RESET}" if daemon_running else f"{CLR_DIM}STOPPED{CLR_RESET}"

    sep = "=" * 68
    sub_sep = "-" * 68
    print("\n" + sep)
    title = f"Antigravity Multi-Account Pool v{VERSION}"
    print(f"{CLR_BOLD}{title:^68}{CLR_RESET}")
    print(sep)

    active_id = pool.get("active_account_id")
    for i, acc in enumerate(accounts, start=1):
        acc_id = acc.get("id", f"acc_{i}")
        is_active = (acc_id == active_id)
        q = acc.get("last_quota", {})
        g5 = q.get("gemini_5h", {})
        gw = q.get("gemini_weekly", {})
        tp5 = q.get("third_party_5h", {})
        status = acc.get("status")

        g5_frac, gw_frac = _display_quota_fractions(q)
        legacy_reset = q.get("reset_time") if "gemini_5h" not in q and "gemini_weekly" not in q else None
        g5_reset = format_remaining_time(g5.get("reset_time", legacy_reset))
        gw_reset = format_remaining_time(gw.get("reset_time", legacy_reset))

        g5_bar = render_progress_bar(g5_frac, width=10)
        gw_bar = render_progress_bar(gw_frac, width=10)

        now_ts = time.time()
        is_cooling = acc.get("rate_limited_until", 0) > now_ts
        is_exhausted = any(fraction is not None and fraction <= 0.005 for fraction in (g5_frac, gw_frac))

        hits = acc.get("gen_count", acc.get("request_count", 0))

        if status == "validation_required":
            marker = f"{CLR_YELLOW}⚠ Verify Required{CLR_RESET}"
        elif status == "auth_error":
            marker = f"{CLR_RED}✖ Auth Error{CLR_RESET}"
        elif is_cooling:
            marker = f"{CLR_YELLOW}* Active (Cooldown){CLR_RESET}" if is_active else f"{CLR_YELLOW}Cooldown{CLR_RESET}"
        elif is_exhausted:
            marker = f"{CLR_RED}* Active (Exhausted){CLR_RESET}" if is_active else f"{CLR_DIM}Exhausted{CLR_RESET}"
        elif is_active:
            marker = f"{CLR_GREEN}* Active{CLR_RESET}"
        else:
            marker = f"{CLR_CYAN}Ready{CLR_RESET}"
        disp_name = display_account_name(acc)

        print(f"{CLR_BOLD}[{i}] {disp_name}{CLR_RESET}  [{marker}]  Hits: {hits}")

        if status == "validation_required":
            print(f"    • Gemini 5-Hour: {CLR_YELLOW}[░░░░░░░░░░]  Action Required (Blocked){CLR_RESET}")
            print(f"    • Gemini Weekly: {CLR_YELLOW}[░░░░░░░░░░]  Action Required (Blocked){CLR_RESET}")
            print(f"    {CLR_YELLOW}↳ Google requires security verification for this account.{CLR_RESET}")
            print(f"      Run {CLR_BOLD}agy-pool verify {i}{CLR_RESET} to unlock in browser.")
        elif status == "auth_error":
            print(f"    • Gemini 5-Hour: {CLR_RED}[░░░░░░░░░░]  Authentication Failure{CLR_RESET}")
            print(f"    • Gemini Weekly: {CLR_RED}[░░░░░░░░░░]  Authentication Failure{CLR_RESET}")
            print(f"    {CLR_RED}↳ Token expired or revoked. Re-authenticate account.{CLR_RESET}")
        else:
            print(f"    • Gemini 5-Hour: {g5_bar}  (Resets {g5_reset})")
            print(f"    • Gemini Weekly: {gw_bar}  (Resets {gw_reset})")
            print(f"    • Quota age: {format_quota_age(acc)}")

            if tp5 and tp5.get("fraction") is not None and tp5.get("fraction") < 1.0:
                tp_bar = render_progress_bar(tp5.get("fraction"), width=10)
                tp_reset = format_remaining_time(tp5.get("reset_time"))
                print(f"    • Claude/GPT 5h: {tp_bar}  (Resets {tp_reset})")

        if i < len(accounts):
            print()

    print(sub_sep)
    print(f" {CLR_GREEN}[* Active]{CLR_RESET} {CLR_DIM}CLI Base Token{CLR_RESET}    {CLR_CYAN}[Ready]{CLR_RESET} {CLR_DIM}In Rotation Pool{CLR_RESET}")
    print(f" {CLR_YELLOW}[Cooldown]{CLR_RESET} {CLR_DIM}Rate Limited{CLR_RESET}      {CLR_DIM}[Exhausted] Quota Depleted{CLR_RESET}")
    print(f" Strategy: {CLR_BOLD}{pool.get('strategy', 'max_quota')}{CLR_RESET} | Gateway Proxy: {gateway_status}")
    print(sep + "\n")


