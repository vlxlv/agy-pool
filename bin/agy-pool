def manage_strategy(target_strategy=None):
    VALID_STRATEGIES = scheduler.VALID_STRATEGIES
    pool = load_pool()
    current = pool.get("strategy", "max_quota")
    if not target_strategy:
        print(f"\nCurrent load balancing strategy: {CLR_BOLD}{CLR_GREEN}{current}{CLR_RESET}\n")
        print("Available strategies:")
        print(f"  • {CLR_BOLD}max_quota{CLR_RESET}   - Prioritizes accounts with safest remaining 5-hour and weekly quota, taking reset times into account (default)")
        print(f"  • {CLR_BOLD}least_used{CLR_RESET}  - Distributes load evenly to accounts with lowest AI generation count (Hits)")
        print(f"  • {CLR_BOLD}round_robin{CLR_RESET} - Cycles through ready accounts in sequential rotation\n")
        print(f"To update strategy: {CLR_BOLD}agy-pool strategy <name>{CLR_RESET}\n")
        return current

    target_strategy = target_strategy.lower().strip()
    if target_strategy not in VALID_STRATEGIES:
        print(f"{CLR_RED}[Error] Invalid strategy '{target_strategy}'. Choose from: {', '.join(VALID_STRATEGIES)}{CLR_RESET}")
        return False

    def update(pool):
        pool["strategy"] = target_strategy
    pool_transaction(update)
    print(f"{CLR_GREEN}✓ Load balancing strategy set to: {CLR_BOLD}{target_strategy}{CLR_RESET}")
    return True


